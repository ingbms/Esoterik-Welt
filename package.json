{
  "name": "esoterik-welt",
  "version": "1.0.0",
  "description": "Esoterik-Welt - A platform for esoteric content and community",
  "main": "index.js",
  "scripts": {
    "prestart": "npm run build:legacy",
    "start": "node index.js",
    "predev": "node scripts/sync-public-assets.cjs --quiet",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-public-assets.cjs --quiet",
    "content:migrate": "node scripts/migrate-content.cjs",
    "routes:generate": "node scripts/generate-legacy-map.cjs",
    "verify:migration": "node scripts/verify-migration.cjs",
    "test": "jest",
    "test:unit": "jest",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,ts,astro,html,css}\" --ignore-unknown",
    "build": "astro build",
    "build:local": "node scripts/build-local.cjs",
    "preview": "astro preview",
    "test:pages": "node --test tests/pages-regression.cjs",
    "test:crystals": "node --test tests/crystals-attribution.cjs",
    "test:frequencies": "node --test tests/frequencies-data.cjs",
    "test:frequenz": "node --test tests/frequenz-engine.mjs tests/frequenz-presets.mjs tests/markdown-lite.mjs tests/frequenz-chladni.mjs tests/frequenz-meditation.mjs",
    "check:frequenz-budget": "node scripts/check-frequenz-budget.cjs",
    "test:e2e": "npm run build:legacy && playwright test",
    "test:offline": "npm run build:local && node --test tests/offline-file.cjs",
    "test:tarot": "node --test tests/tarot-deck.cjs",
    "test:tarot:decks": "node --test tests/tarot-decks-v2.cjs",
    "test:moon": "node --test tests/moon-astro.cjs",
    "test:astrologie": "node --test tests/astrologie.mjs",
    "test:radiasthesie": "node --test tests/radiasthesie.mjs",
    "test:radiasthesie:statisch": "node --test tests/radiasthesie-statisch.mjs",
    "test:radiasthesie:vertraege": "node --test tests/radiasthesie-vertraege.mjs",
    "test:radiasthesie:simulator": "node --test tests/radiasthesie-simulator.mjs",
    "test:radiasthesie:tafeln": "node --test tests/pendeltafel-studio.mjs",
    "test:radiasthesie:experiment": "node --test tests/experiment-statistik.mjs",
    "test:radiasthesie:journal": "node --test tests/journal-speicher.mjs",
    "test:farbwelten": "node --test tests/farbwelten.mjs tests/farbwelten-sources.mjs",
    "verify:sync": "node scripts/verify-farbwelten-sync.cjs",
    "data:astrologie": "node scripts/generate-astrologie-data.cjs",
    "data:radiasthesie": "node scripts/generate-radiasthesie-data.cjs && npx prettier --write js/data/radiasthesie.js",
    "data:farbwelten": "node scripts/generate-farbwelten-data.cjs && npx prettier --write js/data/farbwelten.js",
    "test:all": "npm run test:unit && npm run test:pages && npm run test:crystals && npm run test:frequencies && npm run test:frequenz && npm run check:frequenz-budget && npm run test:astrologie && npm run test:radiasthesie && npm run test:radiasthesie:statisch && npm run test:radiasthesie:vertraege && npm run test:radiasthesie:simulator && npm run test:radiasthesie:tafeln && npm run test:radiasthesie:experiment && npm run test:radiasthesie:journal && npm run test:farbwelten && npm run verify:sync && npm run test:tarot && npm run test:tarot:decks && npm run test:moon && npm run test:offline && npm run test:e2e",
    "verify:pages": "node scripts/verify-pages.cjs",
    "verify:farbwelten": "node scripts/verify-farbwelten.cjs",
    "verify:build": "node scripts/verify-build.cjs",
    "test:local": "npm run build:legacy && node --test tests/local-entry.cjs tests/pages-regression.cjs",
    "serve": "python -m http.server 8080",
    "static": "python -m http.server 3000",
    "check": "astro check",
    "sync": "astro sync",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,cjs,mjs,ts,astro,html,css}\"",
    "dev:legacy": "nodemon index.js",
    "preview:legacy": "node index.js",
    "build:legacy": "node scripts/build-pages.cjs"
  },
  "keywords": [
    "esoterik",
    "spirituality",
    "community",
    "platform"
  ],
  "author": "Esoterik-Welt Team",
  "license": "MIT",
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "9.39.1",
    "@lhci/cli": "^0.15.1",
    "eslint": "9.39.1",
    "eslint-plugin-astro": "1.7.0",
    "globals": "16.5.0",
    "jest": "^29.0.0",
    "nodemon": "^3.0.0",
    "playwright": "^1.64.1",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "1.1.2",
    "supertest": "^7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.5",
    "cookie": "2.0.1",
    "express": "^4.18.0"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingbms/Esoterik-Welt.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ingbms/Esoterik-Welt/issues"
  },
  "homepage": "https://github.com/ingbms/Esoterik-Welt#readme",
  "engines": {
    "node": ">=22.23.4"
  }
}
