      ],
      "claims": [
        "c17",
        "c19"
      ]
    },
    {
      "id": "gloss-deutung",
      "slug": "deutung",
      "term": "Deutung",
      "definition": "Die Zuordnung von Bedeutung zu einem Zeichen, einer Konstellation oder einem Aspekt. Deutung ist Interpretation, nicht Messung.",
