      "claims": [
        "c07",
        "c23"
      ]
    },
    {
      "id": "gloss-synthese",
      "slug": "synthese",
      "term": "Synthese",
      "definition": "Die Zusammenführung mehrerer Deutungsebenen zu einer gewichteten Lesart. Eine Synthese bleibt Hypothese und sollte ihre Grenzen nennen.",
