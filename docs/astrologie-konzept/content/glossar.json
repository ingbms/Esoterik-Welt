        "gloss-stellium",
        "grund-aspekt-orben"
      ],
      "sources": [
        "S11"
      ],
      "claims": [
        "c10"
      ]
    },
    {
      "id": "gloss-barnum",
      "slug": "barnum-effekt",
      "term": "Barnum-Effekt",
      "definition": "Die Tendenz, vage und allgemeine Persönlichkeitsbeschreibungen als ungewöhnlich treffend zu erleben. Auch Forer-Effekt genannt.",
