        "grund-geschichte"
      ],
      "sources": [
        "S07"
      ],
      "claims": [
        "c23"
      ]
    },
    {
      "id": "gloss-determinismus",
      "slug": "determinismus",
      "term": "Determinismus",
      "definition": "Die Annahme, Ereignisse seien vollständig durch vorherige Bedingungen festgelegt. Eine deterministische Astrologie behauptet, das Horoskop lege das Leben fest; diese Annahme ist nicht belegt.",
      "see_also": [
