        "grund-evidenz"
      ],
      "sources": [
        "S21",
        "S09"
      ],
      "claims": [
        "c20",
        "c17"
      ]
    },
    {
      "id": "gloss-divination",
      "slug": "divination",
      "term": "Divination",
      "definition": "Deutungspraxis, die Zeichen oder Bilder nutzt, um Zusammenhänge oder zukünftige Entwicklungen zu erschließen. Astrologie wird als Form der Divination eingeordnet.",
