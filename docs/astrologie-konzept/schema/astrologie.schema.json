{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esoterik-welt.local/schema/astrologie.schema.json",
  "title": "Astrologie-Konzeptpaket (Datenmodell)",
  "description": "Verbindliches Datenmodell fuer das Inhalts- und Strukturpaket docs/astrologie-konzept. Jede Datei in content/ entspricht genau einem der dataset-Definitionen. Kennzeichnung trennt Deutungstradition, astronomischen Fakt, Konvention und empirische Evidenz.",
  "version": "1.0.0",
  "type": "object",
  "required": ["dataset", "version", "stand"],
  "properties": {
    "dataset": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "stand": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "arbeitsannahme": { "type": "string" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "sourceRef": { "type": "string", "pattern": "^S[0-9]{2}$" },
    "claimRef": { "type": "string", "pattern": "^c[0-9]{2}$" },
    "kennzeichnung": {
      "type": "object",
      "required": ["typ", "hinweis"],
      "additionalProperties": false,
      "properties": {
        "typ": {
          "type": "string",
          "enum": ["deutungstradition", "astronomie", "konvention", "empirie", "historisch", "gemischt"]
        },
        "hinweis": { "type": "string", "minLength": 20 }
      }
    },
    "basis": {
      "type": "object",
      "required": ["id", "slug", "name", "short", "long", "keywords", "sources", "claims", "cross_refs", "kennzeichnung"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "slug": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 2 },
        "short": { "type": "string", "minLength": 60, "maxLength": 600 },
        "long": { "type": "string", "minLength": 400 },
        "keywords": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
        "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sourceRef" } },
        "claims": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/claimRef" } },
        "cross_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "kennzeichnung": { "$ref": "#/$defs/kennzeichnung" }
      }
    },
    "zeichen": {
      "allOf": [{ "$ref": "#/$defs/basis" }],
      "required": ["element", "modality", "polarity", "ruler_traditional", "ruler_modern", "date_range_tropical", "symbol", "strengths", "tensions", "reflection_questions", "common_misreading", "natural_house", "opposite"],
      "properties": {
        "element": { "type": "string", "enum": ["element-feuer", "element-erde", "element-luft", "element-wasser"] },
        "modality": { "type": "string", "enum": ["modalitaet-kardinal", "modalitaet-fix", "modalitaet-veraenderlich"] },
        "polarity": { "type": "string", "enum": ["yang", "yin"] },
        "ruler_traditional": { "$ref": "#/$defs/id" },
        "ruler_modern": { "type": ["string", "null"], "pattern": "^faktor-[a-z]+$" },
        "date_range_tropical": {
          "type": "object",
          "required": ["from", "to", "note"],
          "additionalProperties": false,
          "properties": {
            "from": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{2}$" },
            "to": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{2}$" },
            "note": { "type": "string", "minLength": 20 }
          }
        },
        "symbol": {
          "type": "object",
          "required": ["name", "glyph", "bildsprache"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "glyph": { "type": "string" },
            "bildsprache": { "type": "string", "minLength": 40 }
          }
        },
        "strengths": { "type": "array", "minItems": 4, "maxItems": 6, "items": { "type": "string", "minLength": 20 } },
        "tensions": { "type": "array", "minItems": 4, "maxItems": 6, "items": { "type": "string", "minLength": 20 } },
        "reflection_questions": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "minLength": 25 } },
        "common_misreading": { "type": "string", "minLength": 80 },
        "natural_house": { "type": "string", "pattern": "^haus-([1-9]|1[0-2])$" },
        "opposite": { "type": "string", "pattern": "^zeichen-[a-z]+$" }
      }
    },
    "faktor": {
      "allOf": [{ "$ref": "#/$defs/basis" }],
      "required": ["kind", "astronomy", "themes", "questions", "misreadings", "rulerships", "cycle_text"],
      "properties": {
        "kind": { "type": "string", "enum": ["leuchtkoerper", "planet", "zwergplanet"] },
        "astronomy": {
          "type": "object",
          "required": ["orbital_period_days", "orbital_period_text", "discovery", "visibility", "note"],
          "additionalProperties": false,
          "properties": {
            "orbital_period_days": { "type": ["number", "null"] },
            "orbital_period_text": { "type": "string" },
            "discovery": { "type": "string" },
            "visibility": { "type": "string" },
            "note": { "type": "string", "minLength": 30 }
          }
        },
        "themes": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 3 } },
        "questions": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 20 } },
        "misreadings": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 30 } },
        "rulerships": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["sign", "system"],
            "additionalProperties": false,
            "properties": {
              "sign": { "type": "string", "pattern": "^zeichen-[a-z]+$" },
              "system": { "type": "string", "enum": ["traditionell", "modern"] }
            }
          }
        },
        "cycle_text": { "type": "string", "minLength": 60 }
      }
    },
    "haus": {
      "allOf": [{ "$ref": "#/$defs/basis" }],
      "required": ["number", "natural_sign", "angularity", "hemisphere", "themes", "questions", "caution"],
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 12 },
        "natural_sign": { "type": "string", "pattern": "^zeichen-[a-z]+$" },
        "angularity": { "type": "string", "enum": ["winkelhaus", "sukzedentenhaus", "kadentenhaus"] },
        "hemisphere": { "type": "string", "enum": ["unter_dem_horizont", "ueber_dem_horizont"] },
        "themes": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 3 } },
        "questions": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 20 } },
        "caution": { "type": "string", "minLength": 40 }
      }
    },
    "aspekt": {
      "allOf": [{ "$ref": "#/$defs/basis" }],
      "required": ["angle_deg", "glyph", "traditionelle_qualitaet", "orb", "common_misreading"],
      "properties": {
        "angle_deg": { "type": "integer", "enum": [0, 60, 90, 120, 180] },
        "glyph": { "type": "string" },
        "traditionelle_qualitaet": { "type": "string", "minLength": 30 },
        "orb": {
          "type": "object",
          "required": ["modern_typisch", "spanne", "schulhinweis"],
          "additionalProperties": false,
          "properties": {
            "modern_typisch": { "type": "string" },
            "spanne": { "type": "string" },
            "schulhinweis": { "type": "string", "minLength": 40 }
          }
        },
        "common_misreading": { "type": "string", "minLength": 60 }
      }
    },
    "beispiel": {
      "type": "object",
      "required": ["id", "slug", "titel", "fictional", "no_calculation", "figuren", "annahmen", "schritte", "synthese", "alternative_lesart", "grenzen", "disclaimer", "sources", "claims", "cross_refs", "kennzeichnung"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "slug": { "$ref": "#/$defs/slug" },
        "titel": { "type": "string", "minLength": 8 },
        "fictional": { "const": true },
        "no_calculation": { "const": true },
        "figuren": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
        "annahmen": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 20 } },
        "schritte": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": ["titel", "denkweg", "refs"],
            "additionalProperties": false,
            "properties": {
              "titel": { "type": "string", "minLength": 5 },
              "denkweg": { "type": "string", "minLength": 80 },
              "refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
            }
          }
        },
        "synthese": { "type": "string", "minLength": 300 },
        "alternative_lesart": { "type": "string", "minLength": 100 },
        "grenzen": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 30 } },
        "disclaimer": { "type": "string", "minLength": 80 },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } },
        "claims": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claimRef" } },
        "cross_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "kennzeichnung": { "$ref": "#/$defs/kennzeichnung" }
      }
    },
    "faq": {
      "type": "object",
      "required": ["id", "slug", "frage", "short_answer", "long_answer", "related", "sources", "claims", "kennzeichnung"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "slug": { "$ref": "#/$defs/slug" },
        "frage": { "type": "string", "minLength": 12 },
        "short_answer": { "type": "string", "minLength": 40 },
        "long_answer": { "type": "string", "minLength": 300 },
        "related": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } },
        "claims": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claimRef" } },
        "kennzeichnung": { "$ref": "#/$defs/kennzeichnung" }
      }
    },
    "glossar": {
      "type": "object",
      "required": ["id", "slug", "term", "definition", "see_also", "sources", "claims"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "slug": { "$ref": "#/$defs/slug" },
        "term": { "type": "string", "minLength": 2 },
        "definition": { "type": "string", "minLength": 40 },
        "see_also": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "claims": { "type": "array", "items": { "$ref": "#/$defs/claimRef" } }
      }
    },
    "grundlage": {
      "allOf": [{ "$ref": "#/$defs/basis" }],
      "required": ["title", "level", "key_points"],
      "properties": {
        "title": { "type": "string", "minLength": 4 },
        "level": { "type": "string", "enum": ["grundlagen", "vertiefung", "nachschlagen"] },
        "key_points": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 20 } }
      }
    },
    "lernstufe": {
      "type": "object",
      "required": ["id", "slug", "title", "level", "goal", "reading_time_min", "steps", "check_questions", "next"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "slug": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 5 },
        "level": { "type": "string", "enum": ["grundlagen", "vertiefung", "nachschlagen"] },
        "goal": { "type": "string", "minLength": 60 },
        "reading_time_min": { "type": "integer", "minimum": 5, "maximum": 90 },
        "steps": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["title", "refs", "task"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string", "minLength": 5 },
              "refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
              "task": { "type": "string", "minLength": 60 }
            }
          }
        },
        "check_questions": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 25 } },
        "next": { "type": ["string", "null"] }
      }
    },
    "zeichenDataset": {
      "type": "object",
      "required": ["dataset", "version", "stand", "arbeitsannahme", "items"],
      "properties": { "items": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "$ref": "#/$defs/zeichen" } } }
    },
    "faktorenDataset": {
      "type": "object",
      "required": ["dataset", "version", "stand", "arbeitsannahme", "items"],
      "properties": { "items": { "type": "array", "minItems": 10, "maxItems": 10, "items": { "$ref": "#/$defs/faktor" } } }
    },
    "haeuserDataset": {
      "type": "object",
      "required": ["dataset", "version", "stand", "arbeitsannahme", "items"],
      "properties": { "items": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "$ref": "#/$defs/haus" } } }
    },
    "aspekteDataset": {
      "type": "object",
      "required": ["dataset", "version", "stand", "arbeitsannahme", "items"],
      "properties": { "items": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/aspekt" } } }
    },
    "grundlagenDataset": {
      "type": "object",
      "required": ["dataset", "version", "stand", "arbeitsannahme", "items"],
      "properties": { "items": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/grundlage" } } }
    },
    "beispieleDataset": {
      "type": "object",
      "required": ["dataset", "version", "stand", "arbeitsannahme", "items"],
      "properties": { "items": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/beispiel" } } }
    },
    "faqDataset": {
      "type": "object",
      "required": ["dataset", "version", "stand", "arbeitsannahme", "items"],
      "properties": { "items": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/faq" } } }
    },
    "glossarDataset": {
      "type": "object",
      "required": ["dataset", "version", "stand", "arbeitsannahme", "items"],
      "properties": { "items": { "type": "array", "minItems": 40, "items": { "$ref": "#/$defs/glossar" } } }
    },
    "lernpfadDataset": {
      "type": "object",
      "required": ["dataset", "version", "stand", "arbeitsannahme", "intro", "items"],
      "properties": {
        "intro": { "type": "string", "minLength": 200 },
        "items": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/lernstufe" } }
      }
    },
    "quellenDataset": {
      "type": "object",
      "required": ["dataset", "version", "stand", "quellen", "claims"],
      "properties": {
        "quellen": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object",
            "required": ["id", "titel", "herausgeber", "url", "typ", "abgerufen_am", "sprache", "rechte_hinweis", "abrufstatus", "kurzzitat", "einsatz", "grenzen"],
            "properties": {
              "id": { "$ref": "#/$defs/sourceRef" },
              "titel": { "type": "string", "minLength": 5 },
              "herausgeber": { "type": "string", "minLength": 2 },
              "url": { "type": "string", "pattern": "^https?://" },
              "typ": { "type": "string", "enum": ["primaerquelle", "referenzwerk", "sekundaerquelle", "tertiaerquelle", "lexikon"] },
              "abgerufen_am": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "sprache": { "type": "string", "enum": ["de", "en"] },
              "rechte_hinweis": { "type": "string", "minLength": 30 },
              "abrufstatus": { "type": "string", "minLength": 10 },
              "kurzzitat": { "type": "string", "minLength": 10, "maxLength": 400 },
              "einsatz": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "grenzen": { "type": "string", "minLength": 20 }
            }
          }
        },
        "claims": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object",
            "required": ["id", "aussage", "evidenztyp", "quellen", "sicherheit", "hinweis"],
            "properties": {
              "id": { "$ref": "#/$defs/claimRef" },
              "aussage": { "type": "string", "minLength": 30 },
              "evidenztyp": { "type": "string", "enum": ["astronomischer_fakt", "konvention", "historisch", "empirischer_befund", "deutungstradition"] },
              "quellen": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } },
              "sicherheit": { "type": "string", "enum": ["hoch", "mittel", "niedrig"] },
              "hinweis": { "type": "string", "minLength": 20 }
            }
          }
        }
      }
    }
  }
}
