{
  "ci": {
    "collect": {
      "url": ["http://localhost:3000/"],
      "numberOfRuns": 2,
      "startServerCommand": "python -m http.server 3000"
    },
    "assert": {
      "budgets": [
        {"path": "/*", "resourceSizes": [{"resourceType":"script","budget":150}]},
        {"path":"/*","metrics":{"performance":["error",{"minScore":0.9}],"accessibility":["error",{"minScore":0.95}],"best-practices":["error",{"minScore":0.9}],"seo":["error",{"minScore":0.9}]}}
      ],
      "assertions": {
        "categories:performance": ["warn",{"minScore":0.9}],
        "categories:accessibility": ["error",{"minScore":0.95}],
        "categories:best-practices": ["warn",{"minScore":0.9}],
        "categories:seo": ["warn",{"minScore":0.9}]
      }
    },
    "upload": {"target":"temporary-public-storage"}
  }
}
