---
/** Zwölf Zeichen — Index. */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AreaNav from '../../../components/AreaNav.astro';
import EntryIndex from '../../../components/EntryIndex.astro';
import { ASTROLOGIE_META as META, ZEICHEN } from '../../../data/legacy';
import { ASTROLOGIE_NAV } from '../../../lib/astrologie';

const ROUTE = '/astrologie/zeichen/';
const trail = [{ label: 'Start', href: '/' }, { label: 'Astrologie', href: '/astrologie/' }, { label: 'Zeichen' }];
---

<BaseLayout
  title="Die zwölf Zeichen der westlichen Astrologie"
  description="Zwölf tropische Zeichen mit Bildsprache, Datums-Näherung, Herrscher, Stärken, Spannungen und typischen Missdeutungen — Traditionsmaterial, klar gekennzeichnet."
  trail={trail}
>
  <div class="page-head">
    <p class="label">{ZEICHEN.length} Zeichen</p>
    <h1>Die zwölf Zeichen</h1>
    <p class="lede">{META.arbeitsannahme.zeichen}</p>
    <AreaNav items={ASTROLOGIE_NAV} current={ROUTE} />
  </div>
  <div class="page-body">
    <EntryIndex
      entries={ZEICHEN.map((entry) => ({
        href: `/astrologie/zeichen/${entry.slug}.html`,
        label: `${entry.symbol.glyph} ${entry.name}`,
        note: entry.short,
        meta: `${entry.date_range_tropical.from} – ${entry.date_range_tropical.to}`,
      }))}
    />
  </div>
</BaseLayout>
