---
/** Zwölf Häuser — Index. */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AreaNav from '../../../components/AreaNav.astro';
import EntryIndex from '../../../components/EntryIndex.astro';
import { ASTROLOGIE_META as META, HAEUSER } from '../../../data/legacy';
import { ASTROLOGIE_NAV } from '../../../lib/astrologie';

const ROUTE = '/astrologie/haeuser/';
const trail = [{ label: 'Start', href: '/' }, { label: 'Astrologie', href: '/astrologie/' }, { label: 'Häuser' }];
---

<BaseLayout
  title="Die zwölf Häuser — Lebensfelder im Horoskop"
  description="Zwölf Häuser als zeit- und ortsabhängige Lebensfelder: Themen, Leitfragen, natürliche Zeichen und die Grenzen der Zuordnung."
  trail={trail}
>
  <div class="page-head">
    <p class="label">{HAEUSER.length} Häuser</p>
    <h1>Die zwölf Häuser</h1>
    <p class="lede">{META.arbeitsannahme.haeuser}</p>
    <AreaNav items={ASTROLOGIE_NAV} current={ROUTE} />
  </div>
  <div class="page-body">
    <EntryIndex
      entries={HAEUSER.map((entry) => ({
        href: `/astrologie/haeuser/${entry.slug}.html`,
        label: `${entry.number}. ${entry.name}`,
        note: entry.short,
        meta: entry.natural_sign.replace('zeichen-', ''),
      }))}
    />
  </div>
</BaseLayout>
