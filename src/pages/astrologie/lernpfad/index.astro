---
/** Lernpfad — Index der sechs Stufen. */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AreaNav from '../../../components/AreaNav.astro';
import EntryIndex from '../../../components/EntryIndex.astro';
import { LERNPFAD, LERNPFAD_INTRO } from '../../../data/legacy';
import { ASTROLOGIE_NAV } from '../../../lib/astrologie';

const ROUTE = '/astrologie/lernpfad/';
const trail = [{ label: 'Start', href: '/' }, { label: 'Astrologie', href: '/astrologie/' }, { label: 'Lernpfad' }];
---

<BaseLayout
  title="Lernpfad Astrologie — sechs Stufen"
  description="Sechs Stufen durch die westliche tropische Astrologie: Orientierung, Zeichen, Faktoren und Aspekte, Häuser und Achsen, Synthese, Nachschlagen."
  trail={trail}
>
  <div class="page-head">
    <p class="label">{LERNPFAD.length} Stufen</p>
    <h1>Lernpfad</h1>
    <p class="lede">{LERNPFAD_INTRO}</p>
    <AreaNav items={ASTROLOGIE_NAV} current={ROUTE} />
  </div>
  <div class="page-body">
    <EntryIndex
      entries={LERNPFAD.map((entry) => ({
        href: `/astrologie/lernpfad/${entry.slug}.html`,
        label: entry.title,
        note: entry.goal,
        meta: `${entry.level} · ${entry.reading_time_min} Min`,
      }))}
    />
  </div>
</BaseLayout>
