---
/**
 * Glossar A–Z (17 Begriffe, 9 Buchstabengruppen).
 *
 * Inhalt 1:1 aus dem Bestandsgenerator (Fragment
 * `src/content/radiasthesie/glossar.body.html`): Definitionen, Evidenzstufen,
 * Quellenverweise und Buchstabensprungmarken. Die frühere Astro-Fassung ließ
 * rund 15 % des Textes weg (Review B-2).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RADIASTHESIE as R } from '../../data/legacy';
import { definedTermSet } from '../../lib/jsonld';
import body from '../../content/radiasthesie/glossar.body.html?raw';

const ROUTE = '/radiasthesie/glossar.html';
const trail = [
  { label: 'Start', href: '/' },
  { label: R.module.title, href: '/radiasthesie/' },
  { label: 'Glossar' },
];
const canonical = new URL(ROUTE, Astro.site ?? Astro.url.origin).href;
const termList = R.glossary.flatMap((group) => group.terms);
---

<BaseLayout
  title="Glossar — Radiästhesie, Pendeln und Orakel von A bis Z"
  exactTitle
  description="Begriffe aus Radiästhesie, Pendeln und Orakel kurz erklärt — mit Evidenzstufe A–E und Quellenverweis, ohne Wirkungsversprechen."
  trail={trail}
  mainClass="container rad-root rad-static-main"
  jsonLd={definedTermSet({ url: canonical, name: 'Glossar Radiästhesie, Pendeln und Orakel', terms: termList })}
>
  <Fragment set:html={body} />
</BaseLayout>
