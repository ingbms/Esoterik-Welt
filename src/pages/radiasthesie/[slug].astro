---
/**
 * Themenseiten Radiästhesie / Pendeln / Orakel.
 *
 * Inhalt 1:1 aus dem Bestandsgenerator (`scripts/generate-radiasthesie-pages.cjs`
 * über `scripts/migration/extract-radiasthesie-bodies.cjs`): Kapitel,
 * Inhaltsverzeichnis, Abbildungen, Quellenverweise und Kapitelanker. Die
 * Astro-Neuimplementierung hatte Kapitelabschnitte und das „Auf dieser Seite“
 * verloren (Review B-2/B-3); das Fragment enthält sie vollständig.
 *
 * Die Kapitelanker (`section.id`) bleiben erhalten, damit die alten
 * Hash-Adressen `#pendeln/<thema>/<abschnitt>` weiter auflösen.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RADIASTHESIE as R } from '../../data/legacy';
import radiasthesieBody from '../../content/radiasthesie/radiasthesie.body.html?raw';
import pendelnBody from '../../content/radiasthesie/pendeln.body.html?raw';
import orakelBody from '../../content/radiasthesie/orakel.body.html?raw';

const BODIES: Record<string, string> = {
  radiasthesie: radiasthesieBody,
  pendeln: pendelnBody,
  orakel: orakelBody,
};

export function getStaticPaths() {
  return Object.entries(R.topics).map(([slug, topic]) => ({
    params: { slug },
    props: { topic, slug },
  }));
}

const { topic, slug } = Astro.props;
const ROUTE = `/radiasthesie/${slug}.html`;
const trail = [
  { label: 'Start', href: '/' },
  { label: R.module.title, href: '/radiasthesie/' },
  { label: topic.title },
];
const body = BODIES[slug] ?? '';
---

<BaseLayout
  title={topic.seoTitle}
  exactTitle
  description={topic.description}
  trail={trail}
  mainClass="container rad-root rad-static-main"
  jsonLd={{
    '@type': 'WebPage',
    name: topic.seoTitle,
    description: topic.description,
    hasPart: topic.sections.map((section) => ({
      '@type': 'WebPageElement',
      name: section.title,
      url: `${ROUTE}#${section.id}`,
    })),
  }}
>
  <Fragment set:html={body} />
</BaseLayout>
