---
/**
 * Quellen und Belege — 66 Quellen mit Typ, Jahr, Prüftiefe, Interessenvermerk.
 *
 * Inhalt 1:1 aus dem Bestandsgenerator (Fragment
 * `src/content/radiasthesie/quellen.body.html`). Die Kennungen (`Q01` …) sind
 * Anker (`id="quelle-Q01"`), weil die Kapitel und das Glossar genau darauf
 * verweisen.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RADIASTHESIE as R } from '../../data/legacy';
import body from '../../content/radiasthesie/quellen.body.html?raw';

const trail = [
  { label: 'Start', href: '/' },
  { label: R.module.title, href: '/radiasthesie/' },
  { label: 'Quellen' },
];
---

<BaseLayout
  title="Quellen und Belege — Radiästhesie und Pendeln"
  exactTitle
  description="Alle 66 Quellen des Themenmoduls mit Typ, Jahr, Prüftiefe, Interessenvermerk und, wo einschlägig, den Seiten, die sie belegen."
  trail={trail}
  mainClass="container rad-root rad-static-main"
  jsonLd={{ '@type': 'CollectionPage', name: 'Quellen und Belege', numberOfItems: R.sources.length }}
>
  <Fragment set:html={body} />
</BaseLayout>
