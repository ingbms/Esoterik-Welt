---
/**
 * Radiästhesie / Pendeln / Orakel — Bereichs-Landing.
 *
 * Inhalt: Der Bereich wurde im Bestand von `scripts/generate-radiasthesie-pages.cjs`
 * aus `js/data/radiasthesie.js` erzeugt (Hero, drei Themen mit Fakten und
 * Zeichnungen, Stufenlegende, offene Punkte, Werkstatt, Nachbarschaft,
 * Einordnung). Die erste Astro-Fassung rendere nur einen Teil davon
 * (Review B-2: −39,7 % Text, 0 statt 4 Abbildungen). Deshalb übernimmt die
 * Seite den erzeugten Inhaltsblock 1:1 als Fragment
 * (`src/content/radiasthesie/index.body.html`); Gerüst und `<head>` liefert
 * das Layout. Das Fragment wird mit
 * `node scripts/migration/extract-radiasthesie-bodies.cjs` aus dem Bestand
 * erneuert; `--check` belegt die Aktualität.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RADIASTHESIE as R } from '../../data/legacy';
import body from '../../content/radiasthesie/index.body.html?raw';

const trail = [{ label: 'Start', href: '/' }, { label: R.module.title }];
---

<BaseLayout
  title={R.module.seoTitle}
  exactTitle
  description={R.module.seoDescription}
  trail={trail}
  mainClass="container rad-root rad-static-main"
  jsonLd={{ '@type': 'CollectionPage', name: R.module.title, description: R.module.seoDescription }}
>
  <Fragment set:html={body} />
</BaseLayout>
