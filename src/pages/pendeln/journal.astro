---
/**
 * Pendeltagebuch — eigene Versuche lokal festhalten, exportieren und löschen.
 *
 * Bestandsansicht `#pendeln/journal` (`pendel-journal.js`). Die Einträge
 * bleiben ausschließlich im localStorage dieses Browsers.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PendelnTool from '../../components/PendelnTool.astro';
---

<BaseLayout
  title="Pendeltagebuch — Versuche festhalten und auswerten"
  description="Eigene Versuche lokal festhalten: Frage, Vorhersage, Sicherheit, Ergebnis und spätere Bewertung — mit Export und vollständiger Löschung."
  trail={[
    { label: 'Start', href: '/' },
    { label: 'Radiästhesie', href: '/radiasthesie/' },
    { label: 'Pendeltagebuch' },
  ]}
  mainClass="page-shell"
>
  <PendelnTool view="journal" title="Pendeltagebuch" />
</BaseLayout>
