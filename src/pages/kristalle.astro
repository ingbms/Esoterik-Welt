---
/**
 * Kristalle — Katalog mit Chakra-, Farb- und Wirkungsfilter, Favoriten und
 * Detaildialog.
 *
 * Markup aus dem Bestand (`#crystals`), Initialisierung über dasselbe Modul
 * (`js/modules/crystals.js`). Der Katalogdatensatz (`data/crystals.json`, die
 * Datei, die das Modul tatsächlich lädt) wird als JSON-Insel eingebettet —
 * dieselbe Lösung wie im Offline-Build des Bestands (`#local-crystals-data`);
 * damit entfällt der relative `fetch('./data/crystals.json')`, der in der
 * Astro-Ausgabe sonst ins Leere liefe.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolDialog from '../components/ToolDialog.astro';
import crystalsJson from '../../data/crystals.json';
import body from '../content/tools/kristalle.html?raw';

const payload = JSON.stringify(crystalsJson).replace(/</g, '\\u003c');
---

<BaseLayout
  title="Kristalle & Steine — Chakra, Farbe, Wirkung | VELARKANA"
  description="Kristall-Katalog mit Chakra-, Farb- und Wirkungsfilter: Steine im Überblick, Details und Favoriten."
  mainClass="page-shell"
>
  <Fragment set:html={body} />
  <ToolDialog kind="crystal" />
  <script type="application/json" id="local-crystals-data" set:html={payload} />
</BaseLayout>

<script>
  import { DialogController } from '../../js/dialog.js';
  import { initCrystalsModule } from '../../js/modules/crystals.js';

  const modal = document.getElementById('crystalModal');
  const closeButton = document.getElementById('closeCrystalModal');
  if (modal && closeButton) new DialogController(modal, closeButton);
  initCrystalsModule();
</script>
