---
/**
 * Mondphasen — aktuelle Phase, Zeitachse, Monatskalender, iCal-Export,
 * Phasenregister und Deutung.
 *
 * Markup aus dem Bestand (`#moon`), Berechnung und Kalender aus
 * `js/modules/moon.js` (Meeus, Kap. 48–49) im Browser. Die Datenmodule
 * (`js/data/moon.js`) werden vom Modul selbst geladen.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../content/tools/mondphasen.html?raw';
---

<BaseLayout
  title="Mondphasen, Kalender & Deutung | VELARKANA"
  description="Aktuelle Mondphase mit Beleuchtungsgrad, Zeitachse der vier Hauptphasen, Monatskalender mit Tagesdetails und iCal-Export."
  mainClass="page-shell"
>
  <Fragment set:html={body} />
</BaseLayout>

<script>
  import { MoonModule } from '../../js/modules/moon.js';

  const moon = new MoonModule();
  void moon.init();
</script>
