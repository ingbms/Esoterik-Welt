---
/**
 * Frequenzen — Bibliothek mit Evidenzstatus und Frequenzlabor.
 *
 * Markup aus dem Bestand (`#frequenzen`), Inhalt und Bedienung aus demselben
 * Modul (`js/modules/frequenzlabor.js`, lazy über den Loader). Die Ansicht
 * wird im Browser in `#frequenzlaborRoot` gerendert; ohne JavaScript bleibt
 * der erklärende `<noscript>`-Block lesbar. Interne Links des Moduls
 * (`#frequenzen/labor`) löst der Legacy-Shim des Layouts auf die echten
 * Werkzeugseiten auf.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import body from '../../content/tools/frequenzen.html?raw';
import EmbeddedJson from '../../components/EmbeddedJson.astro';
import frequenciesJson from '../../../data/frequencies.json';
---

<BaseLayout
  title="Frequenzen — Bibliothek, Evidenzstatus und Frequenzlabor | VELARKANA"
  description="Frequenzbibliothek mit Evidenzstatus und interaktives Frequenzlabor: Tongenerator, Oszillogramm, binaurale Demonstration und 432/440-Vergleich."
  mainClass="page-shell"
>
  <Fragment set:html={body} />
  <EmbeddedJson id="local-frequencies-data" data={frequenciesJson} />
</BaseLayout>

<script>
  import { FrequenzlaborLoader } from '../../../js/modules/frequenzlabor-loader.js';

  const root = document.getElementById('frequenzlaborRoot');
  if (root) {
    const loader = new FrequenzlaborLoader(root);
    await loader.show([]);
  }
</script>
