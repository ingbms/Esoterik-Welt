---
/**
 * Quellen und Methodik der Frequenzbibliothek.
 *
 * Der Bestand lud `docs/frequenz-quellen.md` per `fetch` und rendert es im
 * Browser (markdown-lite). Hier rendert der Build dasselbe Dokument aus der
 * Content-Collection — 401 Zeilen Quellenarbeit, die vorher von Suchmaschinen
 * nicht gesehen wurden.
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AreaNav from '../../components/AreaNav.astro';
import TableOfContents from '../../components/TableOfContents.astro';

const entry = await getEntry('dokumente', 'frequenz-quellen');
if (!entry) throw new Error('Dokument frequenz-quellen fehlt in der Collection');
// `headings` kommt aus dem gerenderten Markdown und trägt die IDs, die Astro
// aus den Überschriften erzeugt hat (github-slugger 2.0.0). Das Verzeichnis
// übernimmt sie unverändert — Deep-Links bleiben stabil.
const { Content, headings } = await render(entry);

const ROUTE = '/frequenzen/quellen.html';
const trail = [
  { label: 'Start', href: '/' },
  { label: 'Frequenzen', href: '/frequenzen/' },
  { label: 'Quellen & Methodik' },
];
const NAV = [
  { href: '/frequenzen/', label: 'Bibliothek' },
  { href: '/frequenzen/labor.html', label: 'Frequenzlabor' },
  { href: '/frequenzen/cymatics.html', label: 'Chladni-Muster' },
  { href: '/frequenzen/meditation.html', label: 'Meditation' },
  { href: '/frequenzen/quellen.html', label: 'Quellen & Methodik' },
];
---

<BaseLayout
  title="Quellen & Methodik der Frequenzbibliothek | VELARKANA"
  description="Quellendokument zum Frequenzbereich: Suchstrategie, Aufnahmekriterien, Evidenzstatus, Claim-Quelle-Matrix und Quellenverzeichnis."
  trail={trail}
>
  <div class="page-head">
    <p class="label">Belege</p>
    <h1>Quellen und Methodik</h1>
    <p class="lede">
      Für jeden Eintrag des Frequenzlabors: woher die Zahl kommt, was genau behauptet wird und wie belastbar diese
      Behauptung ist.
    </p>
    <AreaNav items={NAV} current={ROUTE} />
  </div>

  <div class="page-body page-body--toc">
    {/* Verzeichnis vor dem Artikel im DOM: Lesereihenfolge = Abfolge auf
        schmalen Viewports (§5.3 der Spezifikation). Auf Desktop setzt das
        Raster es in die rechte Spalte. */}
    <TableOfContents headings={headings} />
    <article class="prose" data-toc-scope>
      <Content />
    </article>
  </div>
</BaseLayout>
