---
/**
 * Chladni-Muster — interaktive Visualisierung der Modellfamilie.
 *
 * Bestandsansicht `#frequenzen/cymatics`; die Zeichnung entsteht im Browser
 * (`js/modules/frequenz-chladni.js`). Die Seite liefert denselben Bereichskopf
 * wie der Bestand.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import body from '../../content/tools/frequenzen.html?raw';
import EmbeddedJson from '../../components/EmbeddedJson.astro';
import frequenciesJson from '../../../data/frequencies.json';
---

<BaseLayout
  title="Chladni-Muster — Frequenzvisualisierung"
  description="Chladni-Muster als Modell: Knotenlinien, Modusbereich und die Grenzen der Visualisierung — ohne Zuordnung von Frequenz zu Muster."
  trail={[{ label: 'Start', href: '/' }, { label: 'Frequenzen', href: '/frequenzen/' }, { label: 'Chladni-Muster' }]}
  mainClass="page-shell"
>
  <Fragment set:html={body} />
  <EmbeddedJson id="local-frequencies-data" data={frequenciesJson} />
</BaseLayout>

<script>
  import { FrequenzlaborLoader } from '../../../js/modules/frequenzlabor-loader.js';

  const root = document.getElementById('frequenzlaborRoot');
  if (root) {
    const loader = new FrequenzlaborLoader(root);
    await loader.show(['cymatics']);
  }
</script>
