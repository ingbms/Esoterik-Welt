---
/**
 * Frequenzlabor — Tongenerator, Oszillogramm, Schwebung, binaurale
 * Demonstration und 432/440-Vergleich.
 *
 * Dieselbe Bestandsansicht wie `#frequenzen/labor`; der Bereichskopf bleibt
 * wie im Bestand erhalten, die Ansicht rendert das Modul.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import body from '../../content/tools/frequenzen.html?raw';
import EmbeddedJson from '../../components/EmbeddedJson.astro';
import frequenciesJson from '../../../data/frequencies.json';
---

<BaseLayout
  title="Frequenzlabor — Tongenerator, Grenzen und Bedienung"
  description="Wie das Frequenzlabor arbeitet: Presets mit Evidenzstatus, Bedienregeln für Lautstärke und Pausen, technische Grenzen und was es nicht behauptet."
  trail={[{ label: 'Start', href: '/' }, { label: 'Frequenzen', href: '/frequenzen/' }, { label: 'Frequenzlabor' }]}
  mainClass="page-shell"
>
  <Fragment set:html={body} />
  <EmbeddedJson id="local-frequencies-data" data={frequenciesJson} />
</BaseLayout>

<script>
  import { FrequenzlaborLoader } from '../../../js/modules/frequenzlabor-loader.js';

  const root = document.getElementById('frequenzlaborRoot');
  if (root) {
    const loader = new FrequenzlaborLoader(root);
    await loader.show(['labor']);
  }
</script>
