---
/**
 * Meditation — Sitzungsmodell mit Presets, Dauer, Fadeauswahl und Favoriten.
 *
 * Bestandsansicht `#frequenzen/meditation`; Bedienung und Speicherung liegen
 * im Browser (`js/modules/frequenz-meditation-*`). Die Seite liefert denselben
 * Bereichskopf wie der Bestand.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import body from '../../content/tools/frequenzen.html?raw';
import EmbeddedJson from '../../components/EmbeddedJson.astro';
import frequenciesJson from '../../../data/frequencies.json';
---

<BaseLayout
  title="Meditation — Sitzungen mit Tönen"
  description="Meditationssitzungen mit Presets, Dauer und Fadeauswahl: Bedienung, lokale Speicherung und Grenzen — ohne Wirkungsversprechen."
  trail={[
    { label: 'Start', href: '/' },
    { label: 'Frequenzen', href: '/frequenzen/' },
    { label: 'Meditation' },
  ]}
  mainClass="page-shell"
>
  <Fragment set:html={body} />
  <EmbeddedJson id="local-frequencies-data" data={frequenciesJson} />
</BaseLayout>

<script>
  import { FrequenzlaborLoader } from '../../../js/modules/frequenzlabor-loader.js';

  const root = document.getElementById('frequenzlaborRoot');
  if (root) {
    const loader = new FrequenzlaborLoader(root);
    await loader.show(['meditation']);
  }
</script>
