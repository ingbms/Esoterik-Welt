---
/**
 * Startseite.
 *
 * Inhaltlich aus `index.html` übernommen: Hero, „Pfade der Erkenntnis“ mit neun
 * Zugängen, Materialstudie und Kosmos-Tafel. Die neun Zugänge waren im Bestand
 * Hash-Routen derselben Datei; hier sind es echte Dokumente (Migrationsplan
 * §6.4 — einziger Weg, sie crawlbar zu machen).
 *
 * Titel und Description sind wörtlich die SEO-Baseline §6.1 mit der Marke des
 * Arbeitsprojekts (E5/§11.5).
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const TITLE = 'VELARKANA | Tarot, Kristalle, Runen, Mondphasen & Mehr';
const DESCRIPTION = 'VELARKANA — Deine Pforte zu Tarot, Kristallen, Runen, Mondphasen und esoterischem Wissen.';

const PATHS = [
  { href: '/tarot.html', title: 'Tarot', note: '78 Karten, Tageskarte und Legungen' },
  { href: '/kristalle.html', title: 'Kristalle', note: '30 Steine mit Chakra, Farbe und Herkunft' },
  { href: '/mondphasen.html', title: 'Mondphasen', note: 'Acht Phasen, Kalender und Deutung' },
  { href: '/astrologie/', title: 'Astrologie', note: 'Zeichen, Faktoren, Häuser, Lernpfad' },
  { href: '/frequenzen/', title: 'Frequenzen', note: 'Bibliothek mit Evidenzstatus' },
  { href: '/runen.html', title: 'Runen', note: 'Das ältere Futhark, 24 Runen' },
  { href: '/radiasthesie/', title: 'Pendeln', note: 'Radiästhesie, Orakel und Prüfstand' },
  { href: '/farbwelten/', title: 'Farben', note: 'Zwölf Farbwelten zwischen Licht und Tradition' },
  { href: '/wissen/', title: 'Wissen', note: 'Artikel zu Symbolik, Materie und Zyklen' },
];
---

<BaseLayout title={TITLE} description={DESCRIPTION} hero>
  <section class="hero hero-band">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="label">Material · Zeichen · Zyklen</p>
          <h1 id="home-title">
            Entdecke die verborgene Sprache des <em>Universums</em>
          </h1>
          <p class="hero-intro">
            Tarot · Kristalle · Runen · Mondphasen · Astrologie · Frequenzen · Altes Wissen für moderne Suchende. Ein
            ruhiger Zugang zu Material, Symbolik und Zyklen — ohne Wirkungsversprechen.
          </p>
          <div class="hero-actions">
            <a href="/tarot.html" class="btn btn-primary">
              Karte ziehen <span aria-hidden="true">↓</span>
            </a>
            <a href="/astrologie/" class="textlink">
              Astrologie lernen <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <figure class="specimen">
          <img
            class="mineral"
            src="/assets/mineral/quartz-light-2400.jpg"
            width="2400"
            height="2045"
            alt="Räumliche Bergkristallgruppe vor dunklem Grund: durchscheinende Spitzen, geriefte Flächen und gestaffelte Facetten, vollständig im Bild"
          />
          <figcaption class="caption">
            Bergkristall · Fotografie: Didier Descouens · CC BY-SA 4.0
            <br />
            Gewachsene Form, gerichtete Reflexe, echte Einschlüsse.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--ruled" aria-labelledby="pfade-title">
    <div class="container">
      <div class="section-head">
        <h2 id="pfade-title">Pfade der Erkenntnis</h2>
        <p class="label">Neun Zugänge</p>
      </div>
      <p class="section-lede">Wähle dein Tor zur Weisheit — jede Ansicht ist ein eigenes Werkzeug.</p>
      <ul class="entry-grid">
        {PATHS.map((entry, index) => (
          <li>
            <a class="entry-card" href={entry.href}>
              <span class="entry-meta">{String(index + 1).padStart(2, '0')}</span>
              <span class="entry-title">{entry.title}</span>
              <span class="entry-note">{entry.note}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--ruled" aria-labelledby="material-title">
    <div class="container">
      <div class="material-grid">
        <figure class="material-figure">
          <img
            class="detail"
            src="/assets/mineral/mineral-detail-1000.jpg"
            width="1000"
            height="1000"
            loading="lazy"
            decoding="async"
            alt="Detailstudie einer Quarzstufe: eine lange durchscheinende Spitze über milchiger Basis, Riefen und Bruchflächen sichtbar"
          />
          <figcaption class="caption">Detailstudie · Fotografie: Didier Descouens · CC BY-SA 4.0</figcaption>
        </figure>
        <div>
          <p class="label">Material / Bildsprache</p>
          <h2 id="material-title">Ein Stein ist mehr als sein Glanz.</h2>
          <p class="cosmos-text">
            Risse, Trübungen und unregelmäßige Kanten machen das Material lesbar. Licht zeigt den Körper, statt ihn mit
            einer Aura zu übermalen. Erst aus der aufmerksamen Betrachtung entsteht eine eigene Lesart.
          </p>
          <a class="textlink" href="/kristalle.html">
            Zum Kristall-Katalog <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section cosmos" aria-labelledby="kosmos-title">
    <div class="container">
      <div class="cosmos-grid">
        <div>
          <p class="label">Kosmos / Eine zweite Ebene</p>
          <h2 id="kosmos-title">Ein leiser Bezug zum großen Ganzen.</h2>
          <p class="cosmos-text">
            Wenige Punkte, feine Beziehungen. Diese Tafel ordnet, ohne die Materialwelt zu übertönen: Orion als
            reduzierte Koordinatenstudie aus sieben Hauptsternen — nicht als aktueller Himmel und nicht als
            astrologische Vorhersage.
          </p>
          <a class="textlink" href="/wissen/">
            Artikel zu Zyklen und Materie <span aria-hidden="true">↗</span>
          </a>
        </div>
        <figure class="cosmos-figure">
          <img
            class="chart"
            src="/assets/cosmos/orion-chart.svg"
            width="430"
            height="430"
            alt="Orion: sieben Hauptsterne in einer reduzierten Koordinatenprojektion, Norden oben, Osten links"
          />
          <figcaption class="caption">
            Orion · sieben Hauptsterne · Deklination +10° bis −10°
            <br />
            Schematische Projektion; keine Beobachtungsvorhersage. Daten: Sternliste Orion (Wikimedia, abgerufen
            31.10.2026), eigene Vektorzeichnung.
          </figcaption>
          <div class="star-key" aria-label="Sternnamen">
            <span>α Betelgeuse</span>
            <span>β Rigel</span>
            <span>γ Bellatrix</span>
            <span>δ Mintaka</span>
            <span>ε Alnilam</span>
            <span>ζ Alnitak</span>
            <span>κ Saiph</span>
          </div>
        </figure>
      </div>
    </div>
  </section>
</BaseLayout>
