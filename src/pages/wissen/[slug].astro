---
/**
 * Einzelartikel.
 *
 * Der Artikeltext steht als Markdown in `src/content/articles` (früher
 * `js/data/articles.js`). Titel und Description entsprechen der Laufzeit-Regel
 * des Bestands: `<Artikeltitel> — <Marke>` und der Excerpt als Description.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleNode } from '../../lib/jsonld';
import { metaDescription } from '../../lib/astrologie';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const ROUTE = `/wissen/${entry.id}.html`;
const trail = [{ label: 'Start', href: '/' }, { label: 'Wissen', href: '/wissen/' }, { label: entry.data.title }];
const canonical = new URL(ROUTE, Astro.site ?? Astro.url.origin).href;
---

<BaseLayout
  title={entry.data.title}
  description={metaDescription(entry.data.excerpt, 158)}
  trail={trail}
  jsonLd={articleNode({
    url: canonical,
    headline: entry.data.title,
    description: entry.data.excerpt,
    datePublished: entry.data.date,
    section: entry.data.category,
  })}
>
  <div class="page-head">
    <p class="label">
      {entry.data.category} · {entry.data.date} · {entry.data.readTime}
    </p>
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.excerpt}</p>
    <ul class="chip-row">
      {entry.data.tags.map((tag) => (
        <li class="chip">{tag}</li>
      ))}
    </ul>
  </div>

  <div class="page-body">
    {headings.length > 1 && (
      <nav class="area-nav" aria-label="Inhaltsverzeichnis">
        <ul>
          {headings
            .filter((heading) => heading.depth === 2)
            .map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
        </ul>
      </nav>
    )}
    <article class="prose">
      <Content />
    </article>
    <p class="entry-note">
      <a href="/wissen/">Alle Artikel</a>
    </p>
  </div>
</BaseLayout>
