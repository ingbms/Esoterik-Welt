---
/**
 * Runen — 3-Runen-Wurf, Einzelrune, Deutung, Galerie und Wurf-Historie.
 *
 * Markup aus dem Bestand (`#runes`), Wurf und Deutung aus
 * `js/modules/runes.js`, Daten aus `js/data/runes.js`.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolDialog from '../components/ToolDialog.astro';
import body from '../content/tools/runen.html?raw';
---

<BaseLayout
  title="Runen — Das ältere Futhark | VELARKANA"
  description="24 Runen des älteren Futhark: 3-Runen-Wurf, Einzelrune, Deutung und Wurf-Historie."
  mainClass="page-shell"
>
  <Fragment set:html={body} />
  <ToolDialog kind="rune" />
</BaseLayout>

<script>
  import { DialogController } from '../../js/dialog.js';
  import { RunesModule } from '../../js/modules/runes.js';

  const modal = document.getElementById('runeModal');
  const modalBody = document.getElementById('runeModalBody');
  const closeButton = document.getElementById('closeRuneModal');

  if (modal && modalBody && closeButton) {
    new DialogController(modal, closeButton);
    const runes = new RunesModule(modal, modalBody, closeButton);
    void runes.init();
  }
</script>
