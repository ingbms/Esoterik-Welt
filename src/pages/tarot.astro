---
/**
 * Tarot — Ziehungs-Werkzeug, Galerie, Filter und Detaildialog.
 *
 * Die Seite rendert das Bestandsmarkup des Abschnitts `#tarot`
 * (`src/content/tools/tarot.html`) und initialisiert dieselben Vanilla-Module
 * wie die SPA (`js/modules/tarot.js`, `js/dialog.js`). Damit bleiben
 * Kartenraster, Deckwahl (Nachtatelier/Gartenbrevier), Suche, Filter,
 * Tageskarte, 3-Karten-Legung und Verlauf funktional — ohne Framework und ohne
 * zweite Implementierung (Review B-7).
 *
 * Ohne JavaScript bleibt eine leere Galerie; die Karten selbst sind über die
 * Wissensartikel und den Katalogtext erreichbar. Das ist der Preis dafür, die
 * abgenommene Oberfläche nicht durch eine Neugestaltung zu ersetzen.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolDialog from '../components/ToolDialog.astro';
import body from '../content/tools/tarot.html?raw';
---

<BaseLayout
  title="Tarot — 78 Karten, Tageskarte & Legungen | VELARKANA"
  description="Tarot-Karten ziehen und deuten: 78 Karten der Major und Minor Arcana, Tageskarte und 3-Karten-Legung."
  mainClass="page-shell"
>
  <Fragment set:html={body} />
  <ToolDialog kind="card" />
</BaseLayout>

<script>
  import { DialogController } from '../../js/dialog.js';
  import { TarotModule } from '../../js/modules/tarot.js';

  const modal = document.getElementById('cardModal');
  const modalBody = document.getElementById('cardModalBody');
  const closeButton = document.getElementById('closeCardModal');

  if (modal && modalBody && closeButton) {
    new DialogController(modal, closeButton);
    const tarot = new TarotModule(modal, modalBody, closeButton);
    void tarot.init();
  }
</script>
