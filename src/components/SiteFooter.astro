---
/** Fuß — Spalten und Ziele aus dem Footer des Bestands (`index.html`). */
import { SITE_NAME } from '../lib/site';

const COLUMNS = [
  {
    title: 'Tools',
    links: [
      { href: '/tarot.html', label: 'Tarot-Karten' },
      { href: '/kristalle.html', label: 'Kristall-Katalog' },
      { href: '/mondphasen.html', label: 'Mondphasen' },
      { href: '/frequenzen/', label: 'Frequenzlabor' },
      { href: '/runen.html', label: 'Runen-Wurf' },
    ],
  },
  {
    title: 'Wissen',
    links: [
      { href: '/astrologie/', label: 'Astrologie-Bereich' },
      { href: '/radiasthesie/', label: 'Radiästhesie & Pendeln' },
      { href: '/farbwelten/', label: 'Farbwelten & Farben' },
      { href: '/wissen/', label: 'Artikel-Archiv' },
      { href: '/astrologie/lernpfad/', label: 'Lernpfad Astrologie' },
    ],
  },
  {
    title: 'Rechtliches',
    links: [
      { href: '/impressum.html', label: 'Impressum' },
      { href: '/datenschutz.html', label: 'Datenschutz' },
      { href: '/haftung.html', label: 'Haftungsausschluss' },
    ],
  },
];
---

<footer class="footer" role="contentinfo">
  <div class="footer-inner">
    <div class="footer-brand">
      <div class="footer-logo">{SITE_NAME}</div>
      <p class="footer-tagline">
        Eine Sammlung esoterischer Werkzeuge und Wissens für moderne Suchende. Kein Dogma — nur Werkzeuge für deine
        eigene Reise.
      </p>
    </div>
    {COLUMNS.map((column) => (
      <div class="footer-column">
        <h2>{column.title}</h2>
        <ul class="footer-links">
          {column.links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</footer>
