---
/**
 * Fußzeile — aus dem Bestand (`index.html` Footer, Rechtsseiten-Fußzeile).
 *
 * - `full`: Markenblock plus drei Spalten und Schlusszeile (Startseite)
 * - `compact`: nur die Schlusszeile mit Pflichtlinks (Rechtsseiten)
 */
import { FOOTER_BRAND_TEXT, FOOTER_COLUMNS, LEGAL_FOOTER_LINKS, SITE } from '@/data/site';
import { cx } from '@/lib/cx';

export type FooterVariant = 'full' | 'compact';

export interface Props {
  variant?: FooterVariant;
  class?: string;
}

const { variant = 'full', class: className } = Astro.props;
---

<footer class={cx('footer', className)}>
  {variant === 'full' ? (
    <div class="footer-inner">
      <div class="footer-brand">
        <div class="footer-logo">{SITE.name}</div>
        <p class="footer-tagline">{FOOTER_BRAND_TEXT}</p>
      </div>
      {FOOTER_COLUMNS.map((column) => (
        <div class="footer-column">
          <h2>{column.heading}</h2>
          <ul class="footer-links">
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  ) : null}
  <div class="footer-bottom">
    {variant === 'compact' ? (
      <p>
        {LEGAL_FOOTER_LINKS.map((link, index) => (
          <>
            {index > 0 ? ' · ' : null}
            <a href={link.href}>{link.label}</a>
          </>
        ))}
      </p>
    ) : (
      <>
        <p>{SITE.footerNote}</p>
        <p>
          <a href={SITE.repositoryUrl} target="_blank" rel="noopener">
            {SITE.repositoryLabel}
          </a>
        </p>
      </>
    )}
  </div>
</footer>
