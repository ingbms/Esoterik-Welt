---
/**
 * Globales Layout — `<head>`, Kopfzeile, Hauptbereich, Fußzeile.
 *
 * Zusammengeführt aus den beiden Lieferungen der Migration:
 * - Inhaltsbranch (`9e28573`): Canonical-Regeln, Brotkrumen, JSON-LD, Legacy-Hash-Shim
 * - Komponentenbranch (`e934596`): vollständiger `<head>` (OpenGraph, Twitter,
 *   Schrift-Preloads), Header-/Footer-Varianten, Skip-Link
 *
 * Beide Branches waren Geschwister auf `5d9c554` und kollidierten in genau dieser
 * Datei. Die Schnittstelle trägt jetzt die Vereinigung der Props; die Seiten aus
 * der Inhaltsmigration (`trail`, `jsonLd`, `exactTitle`, `omitCanonical`) laufen
 * unverändert weiter, die Komponenten erhalten ihre Varianten-Props.
 *
 * CSS: Der Bestand ist handgeschriebenes CSS mit geprüften Tokens. Er wird
 * unverändert eingebunden (design-system, main, frequenzlabor, radiasthesie,
 * farbwelten) und nur durch `content.css` für die neuen Seitenraster ergänzt.
 */
import '@/styles/global.css';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import JsonLd from '@/components/JsonLd.astro';
import type { FooterVariant } from '@/components/SiteFooter.astro';
import type { HeaderVariant } from '@/components/SiteHeader.astro';
import { canonicalPath, SITE_NAME } from '@/lib/site';
import { breadcrumbList, webPage } from '@/lib/jsonld';

export interface TrailEntry {
  label: string;
  /** Pfad relativ zur Projektbasis; das letzte Element bleibt ohne Link. */
  href?: string;
}

export interface Props {
  /** Anzeigetitel ohne Markensuffix. */
  title: string;
  /**
   * Titel wörtlich verwenden, ohne Markensuffix.
   * Nötig für die Radiästhesie-Dokumente: ihre Titel sind in der SEO-Baseline
   * ohne Marke festgelegt (§6.1) und sollen beim Vergleich Zeichen für Zeichen
   * gleich bleiben.
   */
  exactTitle?: boolean;
  /** Marken-Suffix im `<title>` unterdrücken (z. B. wenn der Titel sie enthält). */
  appendBrand?: boolean;
  /** Meta-Description; ohne Wert wird kein Tag erzeugt. */
  description?: string;
  /** `noindex` für Fehler- und Werkzeugseiten ohne Suchrelevanz. */
  noindex?: boolean;
  /** Vollständiger robots-Wert; überschreibt `noindex`. */
  robots?: string | null;
  /** Kein Canonical (nur 404, wie im Bestand). */
  omitCanonical?: boolean;
  ogType?: 'website' | 'article';
  /** Abweichender OpenGraph-Titel (Bestand nutzt teils Kurzformen). */
  ogTitle?: string;
  /** Abweichende OpenGraph-Description. */
  ogDescription?: string;
  /** Absolute Pfad- oder URL-Angabe für ein Vorschaubild (Bestand: keins). */
  ogImage?: string;
  headerVariant?: HeaderVariant;
  footerVariant?: FooterVariant;
  bodyClass?: string;
  mainClass?: string;
  /** Brotkrumen; erzeugen Navigation und `BreadcrumbList`-JSON-LD. */
  trail?: TrailEntry[];
  /** Zusätzliche strukturierte Daten (z. B. CollectionPage, Article). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Für Layouts, die den Kopf selbst zeichnen (Startseite). */
  hero?: boolean;
}

const {
  title,
  description,
  appendBrand = true,
  noindex = false,
  robots,
  omitCanonical = false,
  ogType = 'website',
  ogTitle,
  ogDescription,
  ogImage,
  headerVariant = 'primary',
  footerVariant = 'full',
  bodyClass,
  mainClass,
  trail = [],
  jsonLd,
  hero = false,
  exactTitle = false,
} = Astro.props;

const path = canonicalPath(Astro.url.pathname);
const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(path, origin).href;

const documentTitle =
  exactTitle || !appendBrand || title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;

// Ein Seitenknoten aus der Seite ersetzt den generischen WebPage-Knoten, statt
// einen zweiten mit derselben Absicht danebenzustellen (Review M-3). Der
// `@id` bleibt der des Layouts, damit `isPartOf`-Referenzen eindeutig bleiben.
const extraNodes: Record<string, unknown>[] = Array.isArray(jsonLd)
  ? jsonLd
  : jsonLd
    ? [jsonLd]
    : [];
const pageOverride = extraNodes.find((node) => node['@type'] === 'WebPage');
const basePage = webPage({ url: canonical, name: documentTitle, description });
const pageNode = pageOverride
  ? { ...basePage, ...pageOverride, '@id': basePage['@id'], url: canonical }
  : basePage;

const structuredData: Record<string, unknown>[] = [
  pageNode,
  ...(trail.length > 0 ? [breadcrumbList(trail, origin)] : []),
  ...extraNodes.filter((node) => node !== pageOverride),
];

const ogImageUrl = ogImage ? new URL(ogImage, origin) : null;
const metaDescription = ogDescription ?? description;
const robotsValue = robots !== undefined ? robots : noindex ? 'noindex, nofollow' : 'index, follow';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    {description && <meta name="description" content={description} />}
    {!omitCanonical && <link rel="canonical" href={canonical} />}
    {robotsValue && <meta name="robots" content={robotsValue} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={ogTitle ?? documentTitle} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    {!omitCanonical && <meta property="og:url" content={canonical} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={documentTitle} />
    {metaDescription && <meta name="twitter:description" content={metaDescription} />}

    {/* Lokale Variable Fonts (SIL OFL 1.1), wie im Bestand vorgeladen. */}
    <link rel="preload" href="/assets/fonts/Fraunces.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/assets/fonts/Manrope.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    {/* Wurzelpfad der Anwendung; der Deploy-Schritt schreibt ihn auf das
        GitHub-Pages-Präfix um. Inseln setzen damit relative Bestandsassets
        korrekt absolut (siehe src/lib/rebase-assets.ts). */}
    <meta name="app-base" content={import.meta.env.BASE_URL} />
    <JsonLd data={structuredData} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Zum Hauptinhalt springen</a>
    <SiteHeader variant={headerVariant} currentPath={Astro.url.pathname} />
    <main
      id="main"
      class:list={[mainClass ?? 'site-main', { 'site-main--hero': hero }]}
      tabindex="-1"
    >
      {trail.length > 0 && <Breadcrumbs trail={trail} />}
      <slot />
    </main>
    <SiteFooter variant={footerVariant} />
    <!-- Legacy-Hash-Shim: alte Adressen wie #astrologie/zeichen/widder werden
         auf ihre neue URL umgeschrieben (Redirect-Map aus src/lib/legacy-routes.ts).
         Der Listener ist nötig, weil eine reine Hash-Navigation innerhalb der
         Seite kein Neuladen auslöst — sonst bliebe ein alter Link stehen. -->
    <script>
      import { resolveLegacyHash } from '../lib/legacy-routes';

      const applyLegacyRedirect = (): void => {
        const target = resolveLegacyHash(window.location.hash, window.location.search);
        if (target) window.location.replace(target);
      };

      applyLegacyRedirect();
      window.addEventListener('hashchange', applyLegacyRedirect);
    </script>
  </body>
</html>
